# Docker Compose defaults. New installs use PostgreSQL 18. Existing PostgreSQL
# 16 installs must set POSTGRES_IMAGE_TAG=16-alpine until after a dump/restore.
POSTGRES_IMAGE_TAG=18-alpine
DATABASE_URL=postgres://postgres:postgres@postgres:5432/getcito
DEPLOYMENT_MODE=local
VITE_DEPLOYMENT_MODE=local
BETTER_AUTH_SECRET=replace-with-random-hex
APP_URL=http://localhost:3001
VITE_APP_URL=http://localhost:3001
VITE_APP_TIMEZONE=Asia/Kolkata
VITE_APP_LOCALE=en-IN
DISABLE_TELEMETRY=1

# Select providers as model:provider[:version][:online].
SCRAPE_TARGETS=chatgpt:openai-api:gpt-5.5:online
ONBOARDING_LLM_TARGET=chatgpt:openai-api:gpt-5.5
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_BASE_URL=
CLORO_API_KEY=
OLOSTEP_API_KEY=
BRIGHTDATA_API_TOKEN=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

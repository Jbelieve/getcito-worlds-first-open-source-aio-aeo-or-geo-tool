# BeAOS deployment template. Real values are rendered from Infisical; never commit .env.
DEPLOYMENT_MODE=local
VITE_DEPLOYMENT_MODE=local
POSTGRES_IMAGE_TAG=18-alpine
DATABASE_URL=postgres://postgres:postgres@beaos-postgres:5432/getcito
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
APP_URL=https://beaos.believe-global.com
VITE_APP_URL=https://beaos.believe-global.com
APP_NAME=BeAOS
APP_ICON=/icons/beaos-icon.svg
APP_PARENT_NAME=Believe
APP_PARENT_URL=https://believe-global.com
VITE_APP_TIMEZONE=America/Bogota
VITE_APP_LOCALE=es-CO
DISABLE_TELEMETRY=1
VITE_CHART_COLORS=#0c3bb9,#00aaff,#16a34a,#f59e0b,#ef4444,#7c3aed,#ec4899,#14b8a6,#8b5cf6,#f97316,#64748b
SCRAPE_TARGETS=chatgpt:openai-api:gpt-5.5:online,google-ai-mode:brightdata:online,perplexity:brightdata:online,claude:anthropic-api:claude-sonnet-4-6:online
ONBOARDING_LLM_TARGET=chatgpt:openai-api:gpt-5.5
OPENAI_API_KEY=from-infisical
ANTHROPIC_API_KEY=from-infisical
BRIGHTDATA_API_TOKEN=from-infisical
ADMIN_API_KEYS=generate-a-long-random-token
MAASY_MCP_TOKEN=from-infisical
# Canonical umbrella signing key. Sub-brands inherit it: a product entity never signs with a key
# of its own, it publishes the umbrella key_id and points key_ref.keys_uri at the umbrella.
# One key per umbrella; today the single umbrella is Believe.
BELIEVE_SIGNING_KEY_ED25519=from-infisical
BELIEVE_SIGNING_KEY_ID=believe-2026-primary
# APS measurement runs are on demand, never a sweep: the guards are per run and per month.
# Leave the USD ceilings unset until one real run is measured and priced.
APS_MAX_PROMPTS=50
APS_MAX_MODELS=3
APS_MAX_REPETITIONS=3
APS_MAX_CALLS_PER_RUN=450
APS_BUDGET_POLICY=stop
# APS_RUN_BUDGET_USD=
# APS_MONTH_BUDGET_USD=
# Juez interno del APS (Fase 1) via BeGateway. APS_JUDGE_VERSION tiene que pinnearse: sin
# version, la serie no puede distinguir una actualizacion del modelo de un cambio de datos.
LLM_GATEWAY_URL=from-infisical
# Mientras no exista la key dedicada de BeAOS se usa la de BeAds: si esta queda vacia, cae a
# LLM_GATEWAY_KEY_BEADS. Una variable vacia NO cuenta como configurada.
LLM_GATEWAY_KEY_BEAOS=
LLM_GATEWAY_KEY_BEADS=from-infisical
APS_JUDGE_MODEL=believe-deep
APS_JUDGE_VERSION=unpinned
# Banda para escribir la biblioteca (trabajo de autoria, no el juicio de la medicion).
APS_LIBRARY_MODEL=believe-smart
# Precios por llamada para el estimador: "target=usd,target=usd". Un target sin precio BLOCKED el
# plan en vez de asumir un numero. Sale de la primera factura real, no de una estimacion mia.
# APS_PRICES=chatgpt=0.02,claude=0.01,perplexity=0.005,believe-deep=0.001
